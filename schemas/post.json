{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dogenals.org/schemas/dsocial-post.json",
  "title": "Ðocial Content Inscription v1.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["p", "v", "op"],
  "properties": {
    "p": { "const": "Ð:SOC" },
    "v": { "enum": ["1.1", "1.0"] },
    "op": {
      "enum": ["post", "reply", "quote", "repost", "profile"]
    },
    "o": {
      "enum": ["p", "r", "q", "rp", "pr"]
    },
    "chain": { "const": "dogecoin" },
    "c": { "const": "dogecoin" },
    "content": { "type": "string", "maxLength": 65536 },
    "ct": { "type": "string", "maxLength": 65536 },
    "pay_to": { "type": "string", "minLength": 1 },
    "pay": { "type": "string", "minLength": 1 },
    "min_like_koinu": {
      "oneOf": [
        { "type": "integer", "minimum": 100000 },
        { "type": "string", "pattern": "^[0-9]+$" }
      ]
    },
    "parent": { "$ref": "#/$defs/inscriptionId" },
    "par": { "$ref": "#/$defs/inscriptionId" },
    "reply_to": { "$ref": "#/$defs/inscriptionId" },
    "quote": { "$ref": "#/$defs/inscriptionId" },
    "q": { "$ref": "#/$defs/inscriptionId" },
    "repost_of": { "$ref": "#/$defs/inscriptionId" },
    "rp": { "$ref": "#/$defs/inscriptionId" },
    "media": {
      "type": "array",
      "items": { "$ref": "#/$defs/mediaRef" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 64 },
      "maxItems": 32
    },
    "mentions": { "type": "array", "items": { "type": "string" } },
    "dms": { "$ref": "#/$defs/inscriptionId" },
    "dx": { "$ref": "#/$defs/inscriptionId" },
    "whisper": { "$ref": "#/$defs/inscriptionId" },
    "lang": { "type": "string", "maxLength": 16 },
    "pinned": { "$ref": "#/$defs/inscriptionId" },
    "context": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "op": { "const": "reply" } } },
      "then": {
        "anyOf": [
          { "required": ["parent"] },
          { "required": ["par"] },
          { "required": ["reply_to"] }
        ]
      }
    },
    {
      "if": { "properties": { "op": { "const": "quote" } } },
      "then": {
        "anyOf": [{ "required": ["quote"] }, { "required": ["q"] }]
      }
    },
    {
      "if": { "properties": { "op": { "const": "repost" } } },
      "then": {
        "anyOf": [{ "required": ["repost_of"] }, { "required": ["rp"] }]
      }
    }
  ],
  "$defs": {
    "inscriptionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}i[0-9]+$"
    },
    "mediaRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "inscription_id": { "$ref": "#/$defs/inscriptionId" },
        "mime": { "type": "string" },
        "alt": { "type": "string" }
      }
    }
  }
}
