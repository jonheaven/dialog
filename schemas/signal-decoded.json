{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dogenals.org/schemas/dsocial-signal-decoded.json",
  "title": "Ðocial Ð:SOC Decoded Signal v1.1",
  "type": "object",
  "required": ["magic", "version", "kind", "target_hash16"],
  "properties": {
    "magic": { "const": "Ð:SOC" },
    "version": { "type": "integer", "const": 1 },
    "kind": {
      "type": "string",
      "enum": ["post", "engage", "follow", "unfollow", "reply", "quote", "repost"]
    },
    "reaction": {
      "type": "string",
      "enum": ["none", "like", "heart", "fire", "laugh", "doge", "checkin", "milestone"]
    },
    "reaction_byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "target_hash16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "nonce": {
      "type": "integer",
      "minimum": 0
    },
    "flags": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "engage" } } },
      "then": {
        "properties": {
          "reaction_byte": { "minimum": 1 }
        }
      }
    }
  ]
}
