{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dogenals.org/schemas/dsocial-engage-decoded.json",
  "title": "Ðocial Engage Event (indexer / API shape)",
  "type": "object",
  "required": ["kind", "target", "sender", "reaction", "txid", "tipped"],
  "properties": {
    "kind": { "const": "engage" },
    "target": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}i[0-9]+$"
    },
    "sender": { "type": "string", "minLength": 1 },
    "reaction": {
      "type": "string",
      "enum": ["like", "heart", "fire", "laugh", "doge", "checkin", "milestone"]
    },
    "txid": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tip_koinu": {
      "type": "integer",
      "minimum": 0
    },
    "tipped": { "type": "boolean" },
    "height": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true,
  "$comment": "tip_koinu is derived from UTXO outputs to pay_to, never from OP_RETURN."
}
